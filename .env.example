# 复制为 .env 后填写。.env 不会被提交（见 .gitignore）。

# 管理口令：强烈建议设置。设置后 /admin 与所有写接口都需要它，
# 未设置时任何人都能通过后台增删视频。
ADMIN_TOKEN=

# 服务端口，默认 8787
# PORT=8787

# 部署到 Vercel / 其他 serverless 平台时的外部存储（本地会忽略）。
# Vercel 控制台 Storage → Upstash for Redis 会自动注入 KV_REST_API_* 两个变量。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
