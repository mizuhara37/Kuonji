{
  "name": "videostation-md3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A Material Design 3 video site whose library is configured by Bilibili bvid through a Node.js admin page (site name comes from config.json)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js",
    "seed:export": "node scripts/export-seed.mjs",
    "kv": "node scripts/kv-tool.mjs",
    "sync": "node scripts/sync-metadata.mjs",
    "deploy": "node scripts/vercel-deploy.mjs",
    "check:api": "node scripts/api-check.mjs",
    "check:vercel": "node scripts/vercel-check.mjs",
    "check:deployed": "node scripts/check-deployed.mjs",
    "check:visual": "node scripts/visual-check.mjs",
    "check:interaction": "node scripts/interaction-check.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright-core": "^1.63.0",
    "sass": "^1.83.0",
    "vite": "^6.0.7",
    "vite-plugin-vuetify": "^2.0.4"
  }
}
